{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "primary_muscle": {
      "type": "string",
      "enum": [
        "chest",
        "back",
        "shoulders",
        "biceps",
        "triceps",
        "quads",
        "hamstrings",
        "glutes",
        "calves",
        "core",
        "full_body",
        "cardio"
      ]
    },
    "secondary_muscles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equipment": {
      "type": "string",
      "enum": [
        "barbell",
        "dumbbell",
        "machine",
        "cable",
        "bodyweight",
        "kettlebell",
        "band",
        "smith_machine",
        "specialty_bar",
        "other"
      ],
      "default": "barbell"
    },
    "movement_type": {
      "type": "string",
      "enum": [
        "compound",
        "isolation",
        "cardio",
        "isometric"
      ],
      "default": "compound"
    },
    "is_time_based": {
      "type": "boolean",
      "default": false
    },
    "instructions": {
      "type": "string"
    },
    "default_rest_seconds": {
      "type": "number",
      "default": 120
    },
    "custom": {
      "type": "boolean",
      "default": false
    },
    "mechanics_type": {
      "type": "string",
      "enum": [
        "normal",
        "assisted"
      ],
      "default": "normal",
      "description": "assisted = counterweighted movement (e.g. assisted pull-up) where logged weight is the assistance, not the load"
    },
    "pinned_cues": {
      "type": "string",
      "description": "Persistent technical setup notes shown in every session (Pro)"
    },
    "primary_sub_muscle": {
      "type": "string",
      "description": "Granular sub-muscle hit as primary target (Pro heatmap)"
    },
    "secondary_sub_muscles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Secondary sub-muscle targets, weighted 0.5 in the heatmap (Pro)"
    }
  },
  "required": [
    "name",
    "primary_muscle"
  ]
}